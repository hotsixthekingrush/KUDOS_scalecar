
material KUDOS/M4_Left
{
    technique
    {
        pass
        {
            lighting on
            ambient 1 1 1
            diffuse 1 1 1

            alpha_rejection greater_equal 128

            texture_unit
            {
                texture m4_left.png
            }
        }
    }
}


